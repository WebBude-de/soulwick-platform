# Local services (infra/docker-compose.yml). Copy to infra/.env.local for `bun run services:up`.
# Local only: on the servers the database is not started from here (production: database server).

# Database: Postgres of the local container (DATABASE_URL in the root .env.local must match)
POSTGRES_DB=soulwick
POSTGRES_USER=soulwick
POSTGRES_PASSWORD=soulwick-local-only

# Ports: host port of Postgres (change if 5432 is taken locally)
DB_PORT=5432
