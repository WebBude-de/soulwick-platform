# Copy to infra/.env for the local services (`bun run services:up`). Never commit the real .env.
# Only Postgres is configured here (no object storage needed yet); the API reads apps/api/.env, the Next apps
# apps/web/.env.local and apps/admin/.env.local. Production values live in Dokploy (DOKPLOY.md).

# --- Database (soulwick-postgres) ---
POSTGRES_DB=soulwick
POSTGRES_USER=soulwick
POSTGRES_PASSWORD=soulwick-local-only
# Host port for PostgreSQL (change if 5432 is already used locally; DATABASE_URL in apps/api/.env must match).
DB_PORT=5432
