// Soulwick platform - Prisma schema (P-010). The tables mirror docs/ARCHITECTURE.md section 3.
// Database names are snake_case (@@map / @map); ids are uuids generated by Postgres
// (gen_random_uuid()), timestamps are timestamptz, so raw SQL and the previous Drizzle data
// layout stay identical.
//
// Two indexes cannot be expressed in Prisma and live in the init migration as hand-written SQL
// (see the Guild model and packages/db/scripts/schema-diff.ts): name and tag of a guild are
// unique among *active* guilds only (P-101), as partial unique indexes
// guilds_name_active_uq (lower(name)) and guilds_tag_active_uq (tag) WHERE disbanded_at IS NULL.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RunMode {
  solo
  quick
  guild

  @@map("run_mode")
}

enum GuildRole {
  founder
  officer
  member

  @@map("guild_role")
}

/// Where a player identity comes from (P-014, crossplay accounts). More providers follow CP0/CP1.
enum IdentityProvider {
  steam
  device
  google_play
  game_center

  @@map("identity_provider")
}

/// How an account was deleted (deletion log, P-026).
enum AccountDeletionChannel {
  web_code
  in_game
  admin

  @@map("account_deletion_channel")
}

/// Processing state of a bug report in the admin panel (P-033).
enum BugReportStatus {
  new
  seen
  done
  wont_fix

  @@map("bug_report_status")
}

/// Bug report or idea from the game's feedback tool (17.10.2026); older builds send bugs only.
enum BugReportKind {
  bug
  idea

  @@map("bug_report_kind")
}

// ---------------------------------------------------------------------------
// Players and identities
// ---------------------------------------------------------------------------

model Player {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// The account's character (P-034, D-152): {character, colors}; null = the game's default.
  appearance Json?
  /// Account XP (D-188): sum of `xp_entries.xp`, kept in step by POST /me/xp and merges. The level
  /// is derived from it (`levelForXp` in @soulwick/contracts), never stored.
  xp         Int      @default(0)

  identities       PlayerIdentity[]
  bans             Ban[]
  /// Up to MAX_GUILDS_PER_PLAYER active guilds (D-147); the limit is enforced by the API.
  guildMemberships GuildMember[]
  foundedGuilds    Guild[]            @relation("GuildFounder")
  reportedRuns     Run[]              @relation("RunReporter")
  runs             RunPlayer[]
  linkCode         LinkCode?
  deletionCode     DeletionCode?
  notes            PlayerNote[]
  /// Bug reports from the game (P-033); deleted with the account (the screenshot may show personal data).
  bugReports       BugReport[]
  /// Name changes (P-034): limit for PATCH /me and moderation history.
  nameChanges      PlayerNameChange[]
  /// Better Auth user that carries the sessions of this player (P-027); created at first login.
  authUser         User?
  /// One row per run that brought (or was refused) account XP (D-188); deleted with the account.
  xpEntries        XpEntry[]
  /// Cloud worlds (D-188, KF8): at most MAX_CLOUD_WORLDS active, the rest archived; deleted with the account.
  cloudWorlds      CloudWorld[]

  @@map("players")
}

/// One player can have several identities (device id, Steam, Google Play, later Game Center).
/// Each login finds or creates one identity; POST /me/link moves identities between accounts
/// (D-121, D-122) and DELETE /me/identities/:provider unlinks them (never the last one).
model PlayerIdentity {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId       String           @map("player_id") @db.Uuid
  provider       IdentityProvider
  providerUserId String           @map("provider_user_id")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt     DateTime         @default(now()) @map("last_used_at") @db.Timestamptz(6)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], map: "player_identities_provider_user_uq")
  @@index([playerId], map: "player_identities_player_id_idx")
  @@map("player_identities")
}

/// Link code of an account (D-121): one active code per player, 10 minutes (TESTWERT). Only an
/// HMAC of the code is stored; the plain code is shown once to the player.
model LinkCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId  String   @unique(map: "link_codes_player_id_unique") @map("player_id") @db.Uuid
  codeHash  String   @unique(map: "link_codes_code_hash_unique") @map("code_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("link_codes")
}

/// One-time deletion code of an account (P-026): one per player, 15 minutes (TESTWERT), only an
/// HMAC is stored. A new code replaces the row including its id, which invalidates confirmation
/// tokens of the old code. `failed_attempts` counts wrong codes typed for this player's name;
/// at the limit the code stops working. The row goes with the account.
model DeletionCode {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId       String   @unique(map: "deletion_codes_player_id_unique") @map("player_id") @db.Uuid
  codeHash       String   @unique(map: "deletion_codes_code_hash_unique") @map("code_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  failedAttempts Int      @default(0) @map("failed_attempts")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("deletion_codes")
}

/// Deletion log (P-026): one row per deleted account, without name or identities. `player_hash`
/// is an HMAC of the player id (key derived from BETTER_AUTH_SECRET, P-027), only to answer "was account X deleted?".
model AccountDeletion {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt  DateTime               @default(now()) @map("deleted_at") @db.Timestamptz(6)
  channel    AccountDeletionChannel
  wasBanned  Boolean                @default(false) @map("was_banned")
  playerHash String?                @map("player_hash")

  @@index([deletedAt], map: "account_deletions_deleted_at_idx")
  @@index([playerHash], map: "account_deletions_player_hash_idx")
  @@map("account_deletions")
}

// ---------------------------------------------------------------------------
// Better Auth (P-027): admins, moderators and the sessions of players
// ---------------------------------------------------------------------------
// Field names follow the Better Auth schema (core + plugins admin, jwt and soulwickPlayerAuth),
// tables and columns are snake_case. Ids are uuids (`advanced.database.generateId: "uuid"`), so
// audit_log.admin_id and the other admin references keep their uuid columns.

/// Better Auth user. Admins and moderators sign in with e-mail and password (credential row in
/// auth_accounts); every player gets one row with role `player` and `player_id` at the first
/// login, only to carry the sessions. Player rows have a placeholder e-mail on the reserved
/// `.invalid` domain and no password, so they can never sign in as an admin.
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String    @unique(map: "auth_users_email_unique")
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// admin plugin: `admin`, `moderator` or `player`.
  role          String    @default("player")
  /// admin plugin: a banned user cannot create sessions. Set for disabled admin accounts.
  banned        Boolean   @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires") @db.Timestamptz(6)
  /// soulwickPlayerAuth: the player behind this user (null for admins); goes with the player.
  playerId      String?   @unique(map: "auth_users_player_id_unique") @map("player_id") @db.Uuid
  /// When an admin account was disabled (admin panel); `banned` is the switch Better Auth reads.
  disabledAt    DateTime? @map("disabled_at") @db.Timestamptz(6)

  player            Player?            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sessions          Session[]
  accounts          Account[]
  bansCreated       Ban[]              @relation("BanCreatedBy")
  bansRevoked       Ban[]              @relation("BanRevokedBy")
  auditEntries      AuditLog[]
  playerNotes       PlayerNote[]
  bugReportsHandled BugReport[]
  playerRenames     PlayerNameChange[]

  @@index([role], map: "auth_users_role_idx")
  @@map("auth_users")
}

/// Better Auth session. The token goes to the client signed (`<token>.<signature>`, bearer
/// plugin) and comes back as `Authorization: Bearer`. IP tracking is off (no IP stored).
model Session {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  token          String   @unique(map: "auth_sessions_token_unique")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id") @db.Uuid
  /// admin plugin (impersonation; not used by Soulwick).
  impersonatedBy String?  @map("impersonated_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@map("auth_sessions")
}

/// Better Auth account: `provider_id = 'credential'` holds the argon2id hash of an admin password
/// (Bun.password, same PHC strings as the former admin_users.password_hash).
model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "auth_accounts_user_id_idx")
  @@map("auth_accounts")
}

/// Better Auth verification values (e-mail verification, password reset; unused so far).
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier], map: "auth_verifications_identifier_idx")
  @@map("auth_verifications")
}

/// jwt plugin: signing keys of the short-lived player JWTs for the relay (GET /auth/token). The
/// private key is encrypted with BETTER_AUTH_SECRET; keys rotate (`expires_at`), the public half
/// stays in GET /auth/jwks until the grace period after expiry is over.
model Jwks {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  alg        String?
  crv        String?

  @@map("auth_jwks")
}

// ---------------------------------------------------------------------------
// Bans, notes, audit
// ---------------------------------------------------------------------------

model Ban {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId         String    @map("player_id") @db.Uuid
  reason           String
  createdByAdminId String?   @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// null = permanent
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy        String?   @map("revoked_by") @db.Uuid

  player         Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdByAdmin User?  @relation("BanCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  revokedByAdmin User?  @relation("BanRevokedBy", fields: [revokedBy], references: [id], onDelete: SetNull)

  @@index([playerId], map: "bans_player_id_idx")
  @@map("bans")
}

/// Internal moderation note on a player (admin panel, P-023); never shown to the player. Deleted
/// with the player; the author reference is cleared if the admin account disappears.
model PlayerNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  adminId   String?  @map("admin_id") @db.Uuid
  text      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  admin  User?  @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([playerId, createdAt], map: "player_notes_player_id_created_at_idx")
  @@map("player_notes")
}

/// One name change of a player (P-034): counts for the limit of PATCH /me (rows without admin)
/// and shows the history in the admin panel. Goes with the player; older rows than
/// NAME_HISTORY_RETENTION_DAYS (TESTWERT 90) are removed by the housekeeping job.
model PlayerNameChange {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  oldName   String   @map("old_name")
  newName   String   @map("new_name")
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  /// Set when an admin or moderator renamed the player; null = the player.
  adminId   String?  @map("admin_id") @db.Uuid

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  admin  User?  @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([playerId, changedAt], map: "player_name_changes_player_id_changed_at_idx")
  @@index([changedAt], map: "player_name_changes_changed_at_idx")
  @@map("player_name_changes")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "audit_log_created_at_idx")
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Guilds
// ---------------------------------------------------------------------------

/// Partial unique indexes guilds_name_active_uq (lower(name)) and guilds_tag_active_uq (tag),
/// both WHERE disbanded_at IS NULL, are hand-written in the init migration (P-101).
model Guild {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  /// 2-5 characters, stored upper case.
  tag         String
  inviteCode  String    @unique(map: "guilds_invite_code_unique") @map("invite_code")
  founderId   String?   @map("founder_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  disbandedAt DateTime? @map("disbanded_at") @db.Timestamptz(6)

  founder  Player?        @relation("GuildFounder", fields: [founderId], references: [id], onDelete: SetNull)
  members  GuildMember[]
  progress GuildProgress?
  runs     Run[]

  @@map("guilds")
}

model GuildMember {
  guildId  String    @map("guild_id") @db.Uuid
  /// Several guilds per player since D-147 (the former unique index went with migration multi_guilds).
  playerId String    @map("player_id") @db.Uuid
  role     GuildRole @default(member)
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)

  guild  Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([guildId, playerId])
  @@index([guildId], map: "guild_members_guild_id_idx")
  @@index([playerId], map: "guild_members_player_id_idx")
  @@map("guild_members")
}

model GuildProgress {
  guildId     String @id @map("guild_id") @db.Uuid
  treasury    Int    @default(0)
  /// Forge upgrade id -> level (D-087).
  forgeLevels Json   @default("{}") @map("forge_levels")
  /// Optimistic concurrency token for PATCH /guilds/:id/progress (guild run payouts bump it too).
  version     Int    @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("guild_progress")
}

// ---------------------------------------------------------------------------
// Runs
// ---------------------------------------------------------------------------

model Run {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mode            RunMode
  guildId         String?  @map("guild_id") @db.Uuid
  /// Player who reported the run (the host).
  reportedBy      String?  @map("reported_by") @db.Uuid
  roomReached     Int      @map("room_reached")
  durationSeconds Int      @map("duration_seconds")
  seed            String
  gameVersion     String   @map("game_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  flagged         Boolean  @default(false)
  flagReason      String?  @map("flag_reason")
  /// Idempotency key of the host's report (P-032); a retry with the same key returns this run.
  reportId        String?  @unique(map: "runs_report_id_unique") @map("report_id") @db.Uuid
  /// Gold this run paid into the guild treasury (guild runs with remaining gold), for replays.
  guildPayout     Int?     @map("guild_payout")

  guild        Guild?      @relation(fields: [guildId], references: [id], onDelete: SetNull)
  reporter     Player?     @relation("RunReporter", fields: [reportedBy], references: [id], onDelete: SetNull)
  participants RunPlayer[]

  @@index([mode, createdAt], map: "runs_mode_created_at_idx")
  @@index([guildId], map: "runs_guild_id_idx")
  @@index([flagged, createdAt], map: "runs_flagged_idx")
  /// Time windows of the admin statistics (P-023).
  @@index([createdAt], map: "runs_created_at_idx")
  @@map("runs")
}

model RunPlayer {
  runId    String @map("run_id") @db.Uuid
  playerId String @map("player_id") @db.Uuid

  run    Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([runId, playerId])
  @@index([playerId], map: "run_players_player_id_idx")
  @@map("run_players")
}

// ---------------------------------------------------------------------------
// Bug reports from the game (P-033)
// ---------------------------------------------------------------------------

/// Bug report sent from the in-game feedback tool: screenshot (bytea, at most 1.5 MiB, type from
/// the magic bytes), marks and freehand strokes in relative coordinates, note, categories and a
/// free-form game context. Deleted with the player and automatically after the retention period
/// (BUG_REPORT_RETENTION_DAYS, TESTWERT 90 days). `platform` and `categories` are plain text,
/// validated by the contract, so new values need no migration.
model BugReport {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId    String          @map("player_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  status      BugReportStatus @default(new)
  kind        BugReportKind   @default(bug)
  note        String          @default("")
  categories  String[]        @default([])
  /// [{x, y, w, h, note}], relative 0..1.
  marks       Json            @default("[]")
  /// [[[x, y], ...], ...], relative 0..1.
  strokes     Json            @default("[]")
  context     Json            @default("{}")
  gameVersion String          @map("game_version")
  platform    String
  imageMime   String          @map("image_mime")
  image       Bytes
  /// Admin or moderator who last set a status other than `new`; cleared if the account disappears.
  handledBy   String?         @map("handled_by") @db.Uuid
  handledAt   DateTime?       @map("handled_at") @db.Timestamptz(6)

  player        Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  handledByUser User?  @relation(fields: [handledBy], references: [id], onDelete: SetNull)

  /// Admin list per status, newest first, and the cleanup by age.
  @@index([status, createdAt], map: "bug_reports_status_created_at_idx")
  @@index([createdAt], map: "bug_reports_created_at_idx")
  @@index([playerId], map: "bug_reports_player_id_idx")
  @@map("bug_reports")
}

// ---------------------------------------------------------------------------
// Account XP (D-188, KF3)
// ---------------------------------------------------------------------------

/// One run of one player for the account XP (POST /me/xp). The run id comes from the game and
/// counts once per account (unique with the player); the counts are stored as reported, the XP
/// as computed by the server (`runXp` in @soulwick/contracts). `record_rooms` and
/// `first_run_of_day` are what the server granted. Flagged entries keep 0 XP with the reason.
/// Merging accounts moves the rows (a run id both accounts know stays once); deleting the
/// account deletes them.
model XpEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId        String   @map("player_id") @db.Uuid
  runId           String   @map("run_id") @db.Uuid
  xp              Int
  rooms           Int
  champions       Int
  bosses          Int
  deepestRoom     Int      @map("deepest_room")
  recordRooms     Int      @map("record_rooms")
  firstRunOfDay   Boolean  @map("first_run_of_day")
  /// RunEndReason of the contract (`portal`, `wiped`, `abandoned`); plain text like bug report platforms.
  endReason       String   @map("end_reason")
  players         Int
  durationSeconds Int      @map("duration_seconds")
  gameVersion     String   @map("game_version")
  /// When the run ended (device clock, future values set to the server time).
  endedAt         DateTime @map("ended_at") @db.Timestamptz(6)
  /// UTC day of `ended_at`: one first-run-of-the-day bonus per account and day.
  day             DateTime @db.Date
  flagReason      String?  @map("flag_reason")
  /// Upload time: the daily cap counts the XP credited per UTC day of this column.
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, runId], map: "xp_entries_player_run_uq")
  @@index([playerId, createdAt], map: "xp_entries_player_id_created_at_idx")
  @@map("xp_entries")
}

// ---------------------------------------------------------------------------
// Cloud worlds (D-188, KF8 = CP5, P-038)
// ---------------------------------------------------------------------------

enum CloudWorldStatus {
  active
  archived

  @@map("cloud_world_status")
}

enum CloudWorldSource {
  upload
  restore
  account_merge

  @@map("cloud_world_source")
}

enum CloudWorldBackupReason {
  merge
  restore
  account_merge

  @@map("cloud_world_backup_reason")
}

/// One world of an account in the cloud (contract world.ts). `world_id` comes from the game
/// (`[world] id`, save format v5) and is unique per account; `data` is the save file as JSON
/// (untrusted, never read by leaderboards or the guild treasury). `revision` grows with every new
/// state; the game merges conflicts itself (P-038). The summary columns are what the game reported.
/// Archived worlds are deleted at `expires_at` (housekeeping); deleting the account deletes all.
model CloudWorld {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId        String           @map("player_id") @db.Uuid
  worldId         String           @map("world_id") @db.Uuid
  revision        Int
  status          CloudWorldStatus @default(active)
  source          CloudWorldSource @default(upload)
  data            Json
  sizeBytes       Int              @map("size_bytes")
  formatVersion   Int              @map("format_version")
  gameVersion     String           @map("game_version")
  /// ClientPlatform of the contract; plain text like bug report platforms.
  platform        String
  name            String
  deepestRoom     Int              @map("deepest_room")
  forgeLevel      Int              @map("forge_level")
  forgeMax        Int              @map("forge_max")
  playTimeSeconds Int              @map("play_time_seconds")
  /// `[profile] last_played` (future values capped to the server time on upload).
  lastPlayedAt    DateTime         @map("last_played_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set by the API with its (injectable) clock on every new revision or status change.
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt      DateTime?        @map("archived_at") @db.Timestamptz(6)
  /// Only for archived worlds: deleted after this.
  expiresAt       DateTime?        @map("expires_at") @db.Timestamptz(6)

  player  Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  backups CloudWorldBackup[]

  @@unique([playerId, worldId], map: "cloud_worlds_player_world_uq")
  @@index([status, expiresAt], map: "cloud_worlds_status_expires_at_idx")
  @@map("cloud_worlds")
}

/// A restorable earlier state of a cloud world, kept WORLD_BACKUP_RETENTION_DAYS (`expires_at`):
/// the losing side of a merge, the state a restore replaced, or the other account's state after
/// an account merge (`pending_merge` until the game merged it in).
model CloudWorldBackup {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cloudWorldId    String                 @map("cloud_world_id") @db.Uuid
  reason          CloudWorldBackupReason
  /// Server revision of the saved state; null for a discarded local state.
  fromRevision    Int?                   @map("from_revision")
  pendingMerge    Boolean                @default(false) @map("pending_merge")
  data            Json
  sizeBytes       Int                    @map("size_bytes")
  formatVersion   Int                    @map("format_version")
  gameVersion     String                 @map("game_version")
  platform        String
  name            String
  deepestRoom     Int                    @map("deepest_room")
  forgeLevel      Int                    @map("forge_level")
  forgeMax        Int                    @map("forge_max")
  playTimeSeconds Int                    @map("play_time_seconds")
  lastPlayedAt    DateTime               @map("last_played_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime               @map("expires_at") @db.Timestamptz(6)

  world CloudWorld @relation(fields: [cloudWorldId], references: [id], onDelete: Cascade)

  @@index([cloudWorldId, createdAt], map: "cloud_world_backups_world_created_at_idx")
  @@index([expiresAt], map: "cloud_world_backups_expires_at_idx")
  @@map("cloud_world_backups")
}
