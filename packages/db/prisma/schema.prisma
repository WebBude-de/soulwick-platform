// Soulwick platform - Prisma schema (P-010). The tables mirror docs/ARCHITECTURE.md section 3.
// Database names are snake_case (@@map / @map); ids are uuids generated by Postgres
// (gen_random_uuid()), timestamps are timestamptz, so raw SQL and the previous Drizzle data
// layout stay identical.
//
// Two indexes cannot be expressed in Prisma and live in the init migration as hand-written SQL
// (see the Guild model and packages/db/scripts/schema-diff.ts): name and tag of a guild are
// unique among *active* guilds only (P-101), as partial unique indexes
// guilds_name_active_uq (lower(name)) and guilds_tag_active_uq (tag) WHERE disbanded_at IS NULL.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RunMode {
  solo
  quick
  guild

  @@map("run_mode")
}

enum GuildRole {
  founder
  officer
  member

  @@map("guild_role")
}

/// Where a player identity comes from (P-014, crossplay accounts). More providers follow CP0/CP1.
enum IdentityProvider {
  steam
  device
  google_play
  game_center

  @@map("identity_provider")
}

/// How an account was deleted (deletion log, P-026).
enum AccountDeletionChannel {
  web_code
  in_game
  admin

  @@map("account_deletion_channel")
}

// ---------------------------------------------------------------------------
// Players and identities
// ---------------------------------------------------------------------------

model Player {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  identities      PlayerIdentity[]
  bans            Ban[]
  /// Up to MAX_GUILDS_PER_PLAYER active guilds (D-147); the limit is enforced by the API.
  guildMemberships GuildMember[]
  foundedGuilds   Guild[]          @relation("GuildFounder")
  reportedRuns    Run[]            @relation("RunReporter")
  runs            RunPlayer[]
  linkCode        LinkCode?
  deletionCode    DeletionCode?
  notes           PlayerNote[]
  /// Better Auth user that carries the sessions of this player (P-027); created at first login.
  authUser        User?

  @@map("players")
}

/// One player can have several identities (device id, Steam, Google Play, later Game Center).
/// Each login finds or creates one identity; POST /me/link moves identities between accounts
/// (D-121, D-122) and DELETE /me/identities/:provider unlinks them (never the last one).
model PlayerIdentity {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId       String           @map("player_id") @db.Uuid
  provider       IdentityProvider
  providerUserId String           @map("provider_user_id")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt     DateTime         @default(now()) @map("last_used_at") @db.Timestamptz(6)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], map: "player_identities_provider_user_uq")
  @@index([playerId], map: "player_identities_player_id_idx")
  @@map("player_identities")
}

/// Link code of an account (D-121): one active code per player, 10 minutes (TESTWERT). Only an
/// HMAC of the code is stored; the plain code is shown once to the player.
model LinkCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId  String   @unique(map: "link_codes_player_id_unique") @map("player_id") @db.Uuid
  codeHash  String   @unique(map: "link_codes_code_hash_unique") @map("code_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("link_codes")
}

/// One-time deletion code of an account (P-026): one per player, 15 minutes (TESTWERT), only an
/// HMAC is stored. A new code replaces the row including its id, which invalidates confirmation
/// tokens of the old code. `failed_attempts` counts wrong codes typed for this player's name;
/// at the limit the code stops working. The row goes with the account.
model DeletionCode {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId       String   @unique(map: "deletion_codes_player_id_unique") @map("player_id") @db.Uuid
  codeHash       String   @unique(map: "deletion_codes_code_hash_unique") @map("code_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  failedAttempts Int      @default(0) @map("failed_attempts")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("deletion_codes")
}

/// Deletion log (P-026): one row per deleted account, without name or identities. `player_hash`
/// is an HMAC of the player id (key derived from BETTER_AUTH_SECRET, P-027), only to answer "was account X deleted?".
model AccountDeletion {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deletedAt  DateTime               @default(now()) @map("deleted_at") @db.Timestamptz(6)
  channel    AccountDeletionChannel
  wasBanned  Boolean                @default(false) @map("was_banned")
  playerHash String?                @map("player_hash")

  @@index([deletedAt], map: "account_deletions_deleted_at_idx")
  @@index([playerHash], map: "account_deletions_player_hash_idx")
  @@map("account_deletions")
}

// ---------------------------------------------------------------------------
// Better Auth (P-027): admins, moderators and the sessions of players
// ---------------------------------------------------------------------------
// Field names follow the Better Auth schema (core + plugins admin, jwt and soulwickPlayerAuth),
// tables and columns are snake_case. Ids are uuids (`advanced.database.generateId: "uuid"`), so
// audit_log.admin_id and the other admin references keep their uuid columns.

/// Better Auth user. Admins and moderators sign in with e-mail and password (credential row in
/// auth_accounts); every player gets one row with role `player` and `player_id` at the first
/// login, only to carry the sessions. Player rows have a placeholder e-mail on the reserved
/// `.invalid` domain and no password, so they can never sign in as an admin.
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String    @unique(map: "auth_users_email_unique")
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// admin plugin: `admin`, `moderator` or `player`.
  role          String    @default("player")
  /// admin plugin: a banned user cannot create sessions. Set for disabled admin accounts.
  banned        Boolean   @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires") @db.Timestamptz(6)
  /// soulwickPlayerAuth: the player behind this user (null for admins); goes with the player.
  playerId      String?   @unique(map: "auth_users_player_id_unique") @map("player_id") @db.Uuid
  /// When an admin account was disabled (admin panel); `banned` is the switch Better Auth reads.
  disabledAt    DateTime? @map("disabled_at") @db.Timestamptz(6)

  player       Player?      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sessions     Session[]
  accounts     Account[]
  bansCreated  Ban[]        @relation("BanCreatedBy")
  bansRevoked  Ban[]        @relation("BanRevokedBy")
  auditEntries AuditLog[]
  playerNotes  PlayerNote[]

  @@index([role], map: "auth_users_role_idx")
  @@map("auth_users")
}

/// Better Auth session. The token goes to the client signed (`<token>.<signature>`, bearer
/// plugin) and comes back as `Authorization: Bearer`. IP tracking is off (no IP stored).
model Session {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  token          String   @unique(map: "auth_sessions_token_unique")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id") @db.Uuid
  /// admin plugin (impersonation; not used by Soulwick).
  impersonatedBy String?  @map("impersonated_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@map("auth_sessions")
}

/// Better Auth account: `provider_id = 'credential'` holds the argon2id hash of an admin password
/// (Bun.password, same PHC strings as the former admin_users.password_hash).
model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "auth_accounts_user_id_idx")
  @@map("auth_accounts")
}

/// Better Auth verification values (e-mail verification, password reset; unused so far).
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier], map: "auth_verifications_identifier_idx")
  @@map("auth_verifications")
}

/// jwt plugin: signing keys of the short-lived player JWTs for the relay (GET /auth/token). The
/// private key is encrypted with BETTER_AUTH_SECRET; keys rotate (`expires_at`), the public half
/// stays in GET /auth/jwks until the grace period after expiry is over.
model Jwks {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  alg        String?
  crv        String?

  @@map("auth_jwks")
}

// ---------------------------------------------------------------------------
// Bans, notes, audit
// ---------------------------------------------------------------------------

model Ban {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId         String    @map("player_id") @db.Uuid
  reason           String
  createdByAdminId String?   @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// null = permanent
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy        String?   @map("revoked_by") @db.Uuid

  player         Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdByAdmin User?  @relation("BanCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  revokedByAdmin User?  @relation("BanRevokedBy", fields: [revokedBy], references: [id], onDelete: SetNull)

  @@index([playerId], map: "bans_player_id_idx")
  @@map("bans")
}

/// Internal moderation note on a player (admin panel, P-023); never shown to the player. Deleted
/// with the player; the author reference is cleared if the admin account disappears.
model PlayerNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  adminId   String?  @map("admin_id") @db.Uuid
  text      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  admin  User?  @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([playerId, createdAt], map: "player_notes_player_id_created_at_idx")
  @@map("player_notes")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "audit_log_created_at_idx")
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Guilds
// ---------------------------------------------------------------------------

/// Partial unique indexes guilds_name_active_uq (lower(name)) and guilds_tag_active_uq (tag),
/// both WHERE disbanded_at IS NULL, are hand-written in the init migration (P-101).
model Guild {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  /// 2-5 characters, stored upper case.
  tag         String
  inviteCode  String    @unique(map: "guilds_invite_code_unique") @map("invite_code")
  founderId   String?   @map("founder_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  disbandedAt DateTime? @map("disbanded_at") @db.Timestamptz(6)

  founder  Player?        @relation("GuildFounder", fields: [founderId], references: [id], onDelete: SetNull)
  members  GuildMember[]
  progress GuildProgress?
  runs     Run[]

  @@map("guilds")
}

model GuildMember {
  guildId  String    @map("guild_id") @db.Uuid
  /// Several guilds per player since D-147 (the former unique index went with migration multi_guilds).
  playerId String    @map("player_id") @db.Uuid
  role     GuildRole @default(member)
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)

  guild  Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([guildId, playerId])
  @@index([guildId], map: "guild_members_guild_id_idx")
  @@index([playerId], map: "guild_members_player_id_idx")
  @@map("guild_members")
}

model GuildProgress {
  guildId     String @id @map("guild_id") @db.Uuid
  treasury    Int    @default(0)
  /// Forge upgrade id -> level (D-087).
  forgeLevels Json   @default("{}") @map("forge_levels")
  /// Optimistic concurrency token for PATCH /guilds/:id/progress (guild run payouts bump it too).
  version     Int    @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("guild_progress")
}

// ---------------------------------------------------------------------------
// Runs
// ---------------------------------------------------------------------------

model Run {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mode            RunMode
  guildId         String?  @map("guild_id") @db.Uuid
  /// Player who reported the run (the host).
  reportedBy      String?  @map("reported_by") @db.Uuid
  roomReached     Int      @map("room_reached")
  durationSeconds Int      @map("duration_seconds")
  seed            String
  gameVersion     String   @map("game_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  flagged         Boolean  @default(false)
  flagReason      String?  @map("flag_reason")
  /// Idempotency key of the host's report (P-032); a retry with the same key returns this run.
  reportId        String?  @unique(map: "runs_report_id_unique") @map("report_id") @db.Uuid
  /// Gold this run paid into the guild treasury (guild runs with remaining gold), for replays.
  guildPayout     Int?     @map("guild_payout")

  guild        Guild?      @relation(fields: [guildId], references: [id], onDelete: SetNull)
  reporter     Player?     @relation("RunReporter", fields: [reportedBy], references: [id], onDelete: SetNull)
  participants RunPlayer[]

  @@index([mode, createdAt], map: "runs_mode_created_at_idx")
  @@index([guildId], map: "runs_guild_id_idx")
  @@index([flagged, createdAt], map: "runs_flagged_idx")
  /// Time windows of the admin statistics (P-023).
  @@index([createdAt], map: "runs_created_at_idx")
  @@map("runs")
}

model RunPlayer {
  runId    String @map("run_id") @db.Uuid
  playerId String @map("player_id") @db.Uuid

  run    Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([runId, playerId])
  @@index([playerId], map: "run_players_player_id_idx")
  @@map("run_players")
}
