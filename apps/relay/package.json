    "test": "bun test"
  },
  "dependencies": {
    "@soulwick/contracts": "workspace:*",
    "hono": "^4.13.13",
    "jose": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@soulwick/config": "workspace:*",
    "@types/bun": "^1.4.2",
    "typescript": "~6.0.3"
  }
}
