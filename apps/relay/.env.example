# Copy to apps/relay/.env for local development (`bun run dev:relay`).
# The .env file is read automatically; in Docker/Dokploy set the variables directly.

RELAY_PORT=8790
# Local default "::" listens on IPv6 and IPv4 (Godot resolves localhost to ::1 first). The Docker image sets 0.0.0.0.
# RELAY_HOST=::
# Only clients with exactly this hello.protocolVersion are admitted (game constant, P16).
PROTOCOL_VERSION=1

# Internal URL of the API of the same environment (required, P-027): the relay checks
# hello.token (player JWT from GET /auth/token) against the API's public keys at
# <API_INTERNAL_URL>/auth/jwks and asks the API for ban and guild status with the shared key
# (same as RELAY_INTERNAL_KEY of the API, at least 32 characters; empty key = quick rooms work,
# guild rooms answer api_unavailable). No secret of the API is needed any more.
API_INTERNAL_URL=http://localhost:8787
RELAY_INTERNAL_KEY=
# Optional other JWKS address (default <API_INTERNAL_URL>/auth/jwks).
# JWKS_URL=
# TESTWERT: seconds the key set is reused; an unknown key id refetches earlier (at most every 30 s).
JWKS_CACHE_SECONDS=600
# TESTWERT: seconds an API answer is reused.
STATUS_CACHE_SECONDS=30
# Timeout for the internal status call to the API (ms, min 100).
API_TIMEOUT_MS=2000

# Whom clients may address: host_only (default, Godot server_relay) or any.
CLIENT_ROUTING=host_only

# Limits (TESTWERTE)
MAX_FRAME_BYTES=65536
# Max size of a JSON control message (bytes, TESTWERT).
MAX_CONTROL_BYTES=4096
# Rate-limit violations before the connection is closed with 4008 (TESTWERT).
RATE_LIMIT_STRIKES=5
MAX_MESSAGES_PER_SECOND=1000
MAX_BYTES_PER_SECOND=1048576
MAX_CONNECTIONS_PER_IP_PER_MINUTE=30
MAX_BUFFERED_BYTES=1048576
ROOM_IDLE_MINUTES=10
IDLE_MINUTES=10
HELLO_TIMEOUT_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_TIMEOUT_SECONDS=30

# true behind Dokploy/Traefik (client IP from X-Forwarded-For); false when reached directly.
TRUST_PROXY=false
# info | error | silent
LOG_LEVEL=info

# Bad network, local testing only (ignored with NODE_ENV=production). Also as start options:
# bun run --cwd apps/relay dev --sim-latency=120 --sim-loss=5
RELAY_SIM_LATENCY_MS=0
# Percent (0-100) of unreliable packets (mode 0/1) dropped; reliable packets are never dropped.
RELAY_SIM_LOSS=0
