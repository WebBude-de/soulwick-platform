# Relay (apps/relay). Locally: copy to apps/relay/.env.local; `bun run dev:relay` loads the root
# .env.local first and this file on top. Dokploy: .env.dev / .env.prod are the soulwick-relay
# service's Environment (runtime). TESTWERT marks numbers that are still being tuned.
#
# Also needed, shared through the root .env.* (Dokploy: ${{environment.NAME}}):
#   API_INTERNAL_URL, RELAY_INTERNAL_KEY, PROTOCOL_VERSION

# Server: port and listen address (local "::" takes IPv6 and IPv4, Godot tries ::1 first;
# the Docker image sets 8790 and 0.0.0.0)
RELAY_PORT=8790
# RELAY_HOST=

# Keys: optional other JWKS address (default <API_INTERNAL_URL>/auth/jwks) and seconds the key set
# is reused (TESTWERT; an unknown key id refetches at most every 30 s)
# JWKS_URL=
JWKS_CACHE_SECONDS=600

# Status calls: seconds an API answer is reused (TESTWERT) and timeout in ms (min. 100)
STATUS_CACHE_SECONDS=30
API_TIMEOUT_MS=2000

# Routing: whom clients may address, host_only (Godot server_relay) or any
CLIENT_ROUTING=host_only

# Limits: frame and control message size in bytes, strikes before close 4008, traffic per
# connection, connections per IP, idle and heartbeat times (TESTWERT)
MAX_FRAME_BYTES=65536
MAX_CONTROL_BYTES=4096
RATE_LIMIT_STRIKES=5
MAX_MESSAGES_PER_SECOND=1000
MAX_BYTES_PER_SECOND=1048576
MAX_CONNECTIONS_PER_IP_PER_MINUTE=30
MAX_BUFFERED_BYTES=4194304
# Seconds a receiver may stay over MAX_BUFFERED_BYTES before it is closed (4010), TESTWERT
SLOW_CONSUMER_GRACE_SECONDS=5
ROOM_IDLE_MINUTES=10
IDLE_MINUTES=10
HELLO_TIMEOUT_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_TIMEOUT_SECONDS=30

# Proxy: true behind Cloudflare/Traefik (client IP from CF-Connecting-IP or X-Forwarded-For)
TRUST_PROXY=false

# Logs: info | error | silent
LOG_LEVEL=info

# Bad network: added latency in ms and percent of dropped unreliable packets, local tests only
# (ignored with NODE_ENV=production; also `bun run --cwd apps/relay dev --sim-latency=120 --sim-loss=5`)
RELAY_SIM_LATENCY_MS=0
RELAY_SIM_LOSS=0
