# API (apps/api). Locally: copy to apps/api/.env; `bun run dev:api` loads the root
# .env first and this file on top. Dokploy: .env.dev / .env.prod are the soulwick-api
# service's Environment (runtime). TESTWERT marks numbers that are still being tuned.
#
# Also needed, shared through the root .env.* (Dokploy: ${{environment.NAME}}):
#   DATABASE_URL, BETTER_AUTH_SECRET, DEV_AUTH_KEY, RELAY_INTERNAL_KEY, RELAY_PUBLIC_URL,
#   RELAY_INTERNAL_URL, PROTOCOL_VERSION, MIN_GAME_VERSION, SUPPORT_EMAIL

# Server: local port (port block 1, P-035; the Docker image sets 8787 inside the container)
PORT=3102

# Auth: public API URL (issuer of the player JWTs, https in production; P-027)
BETTER_AUTH_URL=http://localhost:3102

# Sessions: lifetime from the login for players and admins (no sliding refresh)
PLAYER_TOKEN_TTL_DAYS=30
ADMIN_TOKEN_TTL_HOURS=8

# Dev login: POST /auth/dev for the test phase (header x-dev-auth-key = DEV_AUTH_KEY)
DEV_AUTH_ENABLED=true

# Guest login: POST /auth/device per device (P-028, false = 403 guest_auth_disabled);
# limits per IP: logins per minute, new accounts per hour (TESTWERT)
GUEST_AUTH_ENABLED=true
GUEST_LOGINS_PER_MINUTE=10
GUEST_ACCOUNTS_PER_HOUR=20

# Steam: POST /auth/steam (501 until both keys are set). Publisher Web API key from Steamworks,
# never a user key; the identity is the string the game passes to GetAuthTicketForWebApi
STEAM_WEB_API_KEY=
STEAM_APP_ID=
STEAM_TICKET_IDENTITY=soulwick

# Google Play: POST /auth/google-play (501 until both are set), web OAuth client of the Play Games
# Services project (type "Game server")
GOOGLE_PLAY_CLIENT_ID=
GOOGLE_PLAY_CLIENT_SECRET=

# Store logins: timeout per call to Steam, Google, Apple, Discord and the mail worker in ms (TESTWERT)
EXTERNAL_AUTH_TIMEOUT_MS=8000

# Player logins (KF5). Website the game opens for the web login (https in production)
WEB_URL=http://localhost:3100
# Google / Discord sign-in in the browser; empty = off. Redirect URI at the provider:
# <BETTER_AUTH_URL>/auth/oauth/google/callback (discord, apple likewise)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Sign in with Apple: Services ID (web), bundle id (iOS app, POST /auth/apple) and the .p8 key
# (Team ID, Key ID, PEM with \n for line breaks); the key signs the client secret and revokes tokens
APPLE_CLIENT_ID=
APPLE_APP_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Steam sign-in in the browser (OpenID 2.0, no key)
STEAM_OPENID_ENABLED=false
# Game Center: allowed bundle ids of the iOS app (comma separated); empty = off
GAME_CENTER_BUNDLE_IDS=
# Magic links: off | log (development, the mail goes to the API log) | cloudflare (mail worker)
MAIL_ADAPTER=log
MAIL_FROM=
MAIL_CLOUDFLARE_URL=
MAIL_CLOUDFLARE_KEY=
# Login limits (TESTWERT): attempts per IP and minute, failed passwords per username in 15 min,
# magic link mails per IP and hour and per address and hour
LOGIN_ATTEMPTS_PER_MINUTE=20
PASSWORD_FAILURES_PER_USERNAME=10
MAGIC_LINKS_PER_HOUR=10
MAGIC_LINKS_PER_ADDRESS_PER_HOUR=3

# Browser access: allowed origins (comma separated; the game and server-side apps need none)
CORS_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:3110

# Rate limits: requests per IP and minute, POST /me/link per IP and minute,
# POST /account-deletion/verify per IP and hour (TESTWERT)
RATE_LIMIT_PER_MINUTE=120
LINK_ATTEMPTS_PER_MINUTE=10
DELETION_REQUESTS_PER_HOUR=5

# Bug reports from the game (P-033): POST /bug-reports per player and hour, per IP and hour,
# days until a report is deleted automatically (TESTWERT)
BUG_REPORTS_PER_HOUR=10
BUG_REPORTS_PER_IP_PER_HOUR=20
BUG_REPORT_RETENTION_DAYS=90

# Cloud worlds (D-188, P-038): writes under /me/worlds per account and hour (TESTWERT)
WORLD_WRITES_PER_HOUR=120

# Proxy: true behind Cloudflare/Traefik (client IP from CF-Connecting-IP or X-Forwarded-For)
TRUST_PROXY=false
# Peers allowed to set CF-Connecting-IP / X-Forwarded-For when TRUST_PROXY=true (comma-separated
# CIDRs); empty = every peer. On Dokploy: the Docker network of Traefik (infra/DOKPLOY.md)
TRUSTED_PROXY_CIDRS=

# Run reports: plausibility checks (TESTWERT); empty version list = no version check
MIN_SECONDS_PER_ROOM=8
KNOWN_GAME_VERSIONS=

# Relay calls: timeout in ms for live rooms and kicks (TESTWERT)
RELAY_INTERNAL_TIMEOUT_MS=3000

# eRecht24: imprint and privacy policy (P-025, both keys needed, empty = placeholder on the website)
ERECHT24_API_KEY=
ERECHT24_PLUGIN_KEY=

# Logs: usually set once in the root .env for api and relay (see there); set here only to override
# them for the API, e.g. LOG_LEVEL=debug while debugging one route.
# LOG_LEVEL: debug | info | warn | error | silent; LOG_FORMAT: pretty | json (empty = pretty, in
# production json); LOG_DIR: empty = <repo>/logs/api/<day>/ locally, none in production, off = none;
# LOG_RETENTION_DAYS: day folders kept (TESTWERT 7)
# LOG_LEVEL=debug
# LOG_FORMAT=pretty
# LOG_DIR=
# LOG_RETENTION_DAYS=7

# Seed: admin account created by `bun run db:seed`
DEFAULT_ADMIN_EMAIL=admin@soulwick.local
DEFAULT_ADMIN_PASSWORD=soulwick-admin-local
