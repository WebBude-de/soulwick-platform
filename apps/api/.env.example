# Copy to apps/api/.env for local development (`bun run dev:api`).
# The .env file is read automatically; in Docker/Dokploy set the variables directly.

PORT=8787
# Local Postgres from `bun run services:up` (infra/docker-compose.yml, service postgres).
# Host port = DB_PORT from infra/.env (default 5432); user/password/db = POSTGRES_* from infra/.env.
DATABASE_URL=postgres://soulwick:soulwick-local-only@localhost:5432/soulwick
# Migrations: `bun run db:migrate` locally (Prisma, packages/db); the Docker image runs
# `prisma migrate deploy` before the API starts.

# Better Auth (P-027): signs session tokens, encrypts the JWT signing keys, and the HMAC key of
# link and deletion codes is derived from it. At least 32 random characters, e.g.:
# openssl rand -base64 48. One value per environment; the relay does not need it (it reads the
# public keys at GET /auth/jwks). Changing it logs everyone out and voids open codes.
BETTER_AUTH_SECRET=
# Public base URL of this API (issuer of the player JWTs); https in production.
BETTER_AUTH_URL=http://localhost:8787
# Session lifetimes from the login (no sliding refresh): players (/auth/*) and admins.
PLAYER_TOKEN_TTL_DAYS=30
ADMIN_TOKEN_TTL_HOURS=8

# Test phase login POST /auth/dev (header x-dev-auth-key must match DEV_AUTH_KEY, min. 16 chars).
DEV_AUTH_ENABLED=true
DEV_AUTH_KEY=

# Guest login per device POST /auth/device (P-028), no key: the way in for players without Steam
# or Google Play (linked to a store account later via link code). false = 403 guest_auth_disabled.
GUEST_AUTH_ENABLED=true
# TESTWERTE: POST /auth/device per IP and minute; new guest accounts per IP and hour.
GUEST_LOGINS_PER_MINUTE=10
GUEST_ACCOUNTS_PER_HOUR=20

# Steam login POST /auth/steam (P14) - returns 501 provider_not_configured until both are set.
# Publisher Web API key (Steamworks > Users & Permissions > Manage Groups), never the user key.
STEAM_WEB_API_KEY=
STEAM_APP_ID=
# Same string the game passes to GetAuthTicketForWebApi.
STEAM_TICKET_IDENTITY=soulwick

# Google Play Games login POST /auth/google-play (P14) - returns 501 until both are set.
# Web OAuth client of the Google Cloud project linked to Play Games Services (Play Console >
# Play Games Services > Configuration > Credentials, type "Game server").
GOOGLE_PLAY_CLIENT_ID=
GOOGLE_PLAY_CLIENT_SECRET=
# TESTWERT: timeout in ms per call to Steam or Google during a login.
EXTERNAL_AUTH_TIMEOUT_MS=8000

# Comma-separated browser origins allowed via CORS (game client and server-side apps need none).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# TESTWERT: requests per IP and minute.
RATE_LIMIT_PER_MINUTE=120
# TESTWERTE: POST /me/link attempts per IP and minute; POST /account-deletion/verify per IP and hour.
LINK_ATTEMPTS_PER_MINUTE=10
DELETION_REQUESTS_PER_HOUR=5
# true behind a reverse proxy (Dokploy/Traefik); false when the API is reached directly.
TRUST_PROXY=false

# Plausibility checks for run reports (TESTWERT). Empty version list = no version check.
MIN_SECONDS_PER_ROOM=8
KNOWN_GAME_VERSIONS=

# Versions per environment (P16), reported by GET /health and GET /public/config.
# Oldest game version allowed online (e.g. 1.0.0); older games lock online features. Empty = none.
MIN_GAME_VERSION=
# Network protocol version; must equal PROTOCOL_VERSION of the relay of the same environment.
PROTOCOL_VERSION=1
# Public WebSocket URL of the relay of this environment, e.g. wss://play.dev.playsoulwick.com
# (without a path, /v1 is appended). Local relay: ws://localhost:8790. Empty = no relay announced.
RELAY_PUBLIC_URL=

# info | error | silent
LOG_LEVEL=info

# Support address the website shows for account deletion without access to the game
# (GET /public/config supportEmail, P-026). Empty = not shown.
SUPPORT_EMAIL=

# Relay (apps/relay) asks GET /internal/relay/players/:id/status with header x-relay-key.
# Same value as RELAY_INTERNAL_KEY of the relay; at least 32 characters; empty = endpoint disabled.
RELAY_INTERNAL_KEY=
# Internal URL of the relay of this environment for the admin panel's live rooms and the kick
# after a ban (P-024), e.g. http://soulwick-relay:8790 on Dokploy. Needs RELAY_INTERNAL_KEY.
# Empty = /admin/relay/* answers 501 relay_not_configured. Local relay (with the key set above):
# RELAY_INTERNAL_URL=http://localhost:8790
RELAY_INTERNAL_URL=
# TESTWERT: timeout in ms per call to the relay.
RELAY_INTERNAL_TIMEOUT_MS=3000

# Legal texts (imprint, privacy policy) from the eRecht24 Rechtstexte-API v2 (P-025, like DapItUp).
# Both keys are needed (headers eRecht24-api-key and eRecht24-plugin-key); while one is empty,
# GET /legal/:type answers status "missing" and the website shows its placeholder. The API pulls
# on demand and caches in memory (24 h, failures 60 s). Never commit the keys.
ERECHT24_API_KEY=
ERECHT24_PLUGIN_KEY=
ERECHT24_API_URL=https://api.e-recht24.de/v2

# Dev seed only (`bun run db:seed:dev`): password for admin@soulwick.local and moderator@soulwick.local
# (min. 12 characters). Default: soulwick-admin-local. Never set in production; the seed refuses
# to run with NODE_ENV=production anyway.
# DEFAULT_ADMIN_PASSWORD=
