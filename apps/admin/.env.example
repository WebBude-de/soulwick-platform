# Admin panel (apps/admin). Locally: copy to apps/admin/.env.local for `bun run dev:admin`.
# Dokploy: .env.dev / .env.prod are the soulwick-admin service's Environment (runtime).

# API: base URL of the Soulwick API, used only on the server (Dokploy: the internal address)
API_URL=http://localhost:8787

# Cookies: session cookie is Secure (false only for a production build over plain http)
ADMIN_COOKIE_SECURE=true
