# Website (apps/web). Locally: copy to apps/web/.env.local for `bun run dev:web`.
# Dokploy: .env.dev / .env.prod are the soulwick-web service's Environment (runtime).

# API: base URL of the Soulwick API, used only on the server (Dokploy: the internal address)
API_URL=http://localhost:3102
# API: public address for links the browser follows (login buttons for Google, Apple, Discord,
# Steam on /login/<code>). Empty = API_URL (fine locally); Dokploy: the public API domain.
API_PUBLIC_URL=

# Visitor IP for the API's per-IP limits (src/lib/client-ip.ts). TRUST_CLOUDFLARE=true only when the
# domain runs through the Cloudflare proxy (then CF-Connecting-IP counts); TRUSTED_PROXY_HOPS =
# proxies in front of the website that append to X-Forwarded-For (Dokploy: 1 = Traefik).
TRUST_CLOUDFLARE=false
TRUSTED_PROXY_HOPS=1

# URLs: public website (canonical links, hreflang, Open Graph)
SITE_URL=http://localhost:3100

# Live features: leaderboards, guild pages and the leaderboard teaser (unset or true = on; false =
# teaser only, those pages answer 404). Read at runtime, a restart switches it.
LIVE_FEATURES=true

# Game: URL of the browser version of the game (empty = hidden)
GAME_URL=
