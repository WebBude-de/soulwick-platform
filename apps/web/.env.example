# Website (apps/web). Locally: copy to apps/web/.env.local for `bun run dev:web`.
# Dokploy: .env.dev / .env.prod are the soulwick-web service's Environment (runtime).

# API: base URL of the Soulwick API, used only on the server (Dokploy: the internal address)
API_URL=http://localhost:8787

# URLs: public website (canonical links, hreflang, Open Graph)
SITE_URL=http://localhost:3000

# Live features: leaderboards, guild pages and the leaderboard teaser (unset or true = on; false =
# teaser only, those pages answer 404). Read at runtime, a restart switches it.
LIVE_FEATURES=true
