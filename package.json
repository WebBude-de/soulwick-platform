{
  "name": "soulwick-platform",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@soulwick/api",
    "dev:web": "turbo run dev --filter=@soulwick/web",
    "dev:admin": "turbo run dev --filter=@soulwick/admin",
    "dev:relay": "turbo run dev --filter=@soulwick/relay",
    "build": "turbo run build",
    "check": "biome check .",
    "fix": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "turbo run typecheck",
    "test": "bun test --timeout 30000",
    "services:up": "docker compose --env-file infra/.env.local -f infra/docker-compose.yml up -d",
    "services:down": "docker compose --env-file infra/.env.local -f infra/docker-compose.yml down",
    "db:generate": "turbo run generate --filter=@soulwick/db",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:deploy": "bun run --cwd packages/db deploy",
    "db:reset": "bun run --cwd packages/db reset",
    "db:studio": "bun run --cwd packages/db studio",
    "db:status": "bun run --cwd packages/db status",
    "db:verify": "bun run --cwd packages/db verify",
    "db:seed": "bun run --cwd apps/api seed",
    "db:seed:dev": "bun run --cwd apps/api seed:dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "husky": "^9",
    "turbo": "^2.11.5",
    "ultracite": "^7"
  }
}
