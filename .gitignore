# Node / web platform (apps/*, packages/*, infra/)
node_modules/
.next/
dist/
coverage/
.turbo/
*.tsbuildinfo
# generated Prisma client (bun run db:generate)
packages/db/generated/
next-env.d.ts
.env
.env.*
!.env.example
.DS_Store
# UI screenshots taken by agents during verification
.screenshots/
# Local log files of api and relay (@soulwick/logger, LOG_DIR)
logs/

# Agent rules that `next dev` writes into each Next app (the repo-wide AGENTS.md is the real one)
apps/*/AGENTS.md

# Graphify knowledge graph (local, rebuild with: graphify update .)
graphify-out/

# Agent worktrees (git worktree add .worktrees/<name>), never next to the repo
.worktrees/
