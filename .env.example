# All local settings in one file: copy to .env.local (gitignored). Every app, the Prisma CLI and
# docker compose read only the root .env.local. Dokploy: see infra/DOKPLOY.md.
# TESTWERT marks numbers that are still being tuned.

# --- Shared ---

# URLs: public addresses of website, admin panel, API and the browser version of the game
# (local ports: port block 1, P-035)
WEB_URL=http://localhost:3100
ADMIN_URL=http://localhost:3101
API_PUBLIC_URL=http://localhost:3102
# Browser version of the game (soulwick/deploy/web): allowed to call the API (CORS), linked on the website
GAME_URL=http://localhost:3110

# Relay: public WebSocket address announced to the game
RELAY_PUBLIC_URL=ws://localhost:3103

# Internal addresses: how the services reach each other (Dokploy: the App Name of the service)
API_INTERNAL_URL=http://localhost:3102
RELAY_INTERNAL_URL=http://localhost:3103

# Database: Postgres connection (api, Prisma CLI, seeds; production: the database server)
DATABASE_URL=postgres://soulwick:soulwick-local-only@localhost:5532/soulwick

# Secrets: login secret of the API, shared key of API and relay (min. 32 characters) and the
# key of the dev login; one set per environment (openssl rand -base64 48)
BETTER_AUTH_SECRET=
RELAY_INTERNAL_KEY=
DEV_AUTH_KEY=

# Versions: network protocol (API and relay) and oldest game allowed online (empty = none)
PROTOCOL_VERSION=1
MIN_GAME_VERSION=

# Support: address shown for account deletion without the game (empty = hidden)
SUPPORT_EMAIL=hello@playsoulwick.com

# Proxy: true behind Cloudflare/Traefik (client IP from CF-Connecting-IP or X-Forwarded-For)
TRUST_PROXY=false

# Logs of api and relay (@soulwick/logger). LOG_LEVEL: debug | info | warn | error | silent.
# LOG_FORMAT: pretty | json; empty = pretty, in production json (Dokploy reads JSON from stdout).
# LOG_DIR: files logs/<app>/<YYYY-MM-DD>/ (all.jsonl, all.log, <level>.jsonl); empty = <repo>/logs
# locally and no files in production, off = no files, relative paths start at the repo root.
# LOG_RETENTION_DAYS: day folders kept, today included (TESTWERT).
LOG_LEVEL=info
LOG_FORMAT=
LOG_DIR=
LOG_RETENTION_DAYS=7

# --- Local services (infra/docker-compose.yml, `bun run services:up`) ---

# Postgres of the local container (DATABASE_URL above must match)
POSTGRES_DB=soulwick
POSTGRES_USER=soulwick
POSTGRES_PASSWORD=soulwick-local-only
# Host port of Postgres (port block 1 = 5532, P-035; change if taken locally)
DB_PORT=5532

# --- API (apps/api) ---

# Server: local port (port block 1, P-035; the Docker image sets 8787 inside the container)
PORT=3102

# Auth: public API URL (issuer of the player JWTs, https in production; P-027)
BETTER_AUTH_URL=http://localhost:3102

# Sessions: lifetime from the login for players and admins (no sliding refresh)
PLAYER_TOKEN_TTL_DAYS=30
ADMIN_TOKEN_TTL_HOURS=8

# Dev login: POST /auth/dev for the test phase (header x-dev-auth-key = DEV_AUTH_KEY)
DEV_AUTH_ENABLED=true

# Guest login: POST /auth/device per device (P-028, false = 403 guest_auth_disabled);
# limits per IP: logins per minute, new accounts per hour (TESTWERT)
GUEST_AUTH_ENABLED=true
GUEST_LOGINS_PER_MINUTE=10
GUEST_ACCOUNTS_PER_HOUR=20

# Steam: POST /auth/steam (501 until both keys are set). Publisher Web API key from Steamworks,
# never a user key; the identity is the string the game passes to GetAuthTicketForWebApi
STEAM_WEB_API_KEY=
STEAM_APP_ID=
STEAM_TICKET_IDENTITY=soulwick

# Google Play: POST /auth/google-play (501 until both are set), web OAuth client of the Play Games
# Services project (type "Game server")
GOOGLE_PLAY_CLIENT_ID=
GOOGLE_PLAY_CLIENT_SECRET=

# Store logins: timeout per call to Steam, Google, Apple, Discord and the mail worker in ms (TESTWERT)
EXTERNAL_AUTH_TIMEOUT_MS=8000

# Player logins (KF5). Google / Discord sign-in in the browser; empty = off. Redirect URI at the
# provider: <BETTER_AUTH_URL>/auth/oauth/google/callback (discord, apple likewise)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Sign in with Apple: Services ID (web), bundle id (iOS app, POST /auth/apple) and the .p8 key
# (Team ID, Key ID, PEM with \n for line breaks); the key signs the client secret and revokes tokens
APPLE_CLIENT_ID=
APPLE_APP_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Steam sign-in in the browser (OpenID 2.0, no key)
STEAM_OPENID_ENABLED=false
# Game Center: allowed bundle ids of the iOS app (comma separated); empty = off
GAME_CENTER_BUNDLE_IDS=
# Magic links: off | log (development, the mail goes to the API log) | cloudflare (mail worker)
MAIL_ADAPTER=log
MAIL_FROM=
MAIL_CLOUDFLARE_URL=
MAIL_CLOUDFLARE_KEY=
# Login limits (TESTWERT): attempts per IP and minute, failed passwords per username in 15 min,
# magic link mails per IP and hour and per address and hour
LOGIN_ATTEMPTS_PER_MINUTE=20
PASSWORD_FAILURES_PER_USERNAME=10
MAGIC_LINKS_PER_HOUR=10
MAGIC_LINKS_PER_ADDRESS_PER_HOUR=3

# Browser access: allowed origins (comma separated; the game and server-side apps need none)
CORS_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:3110

# Rate limits: requests per IP and minute, POST /me/link per IP and minute,
# POST /account-deletion/verify per IP and hour (TESTWERT)
RATE_LIMIT_PER_MINUTE=120
LINK_ATTEMPTS_PER_MINUTE=10
DELETION_REQUESTS_PER_HOUR=5

# Bug reports from the game (P-033): POST /bug-reports per player and hour, per IP and hour,
# days until a report is deleted automatically (TESTWERT)
BUG_REPORTS_PER_HOUR=10
BUG_REPORTS_PER_IP_PER_HOUR=20
BUG_REPORT_RETENTION_DAYS=90

# Cloud worlds (D-188, P-038): writes under /me/worlds per account and hour (TESTWERT)
WORLD_WRITES_PER_HOUR=120

# Peers allowed to set CF-Connecting-IP / X-Forwarded-For when TRUST_PROXY=true (comma-separated
# CIDRs); empty = every peer. On Dokploy: the Docker network of Traefik (infra/DOKPLOY.md)
TRUSTED_PROXY_CIDRS=

# Run reports: plausibility checks (TESTWERT); empty version list = no version check
MIN_SECONDS_PER_ROOM=8
KNOWN_GAME_VERSIONS=

# Relay calls: timeout in ms for live rooms and kicks (TESTWERT)
RELAY_INTERNAL_TIMEOUT_MS=3000

# eRecht24: imprint and privacy policy (P-025, both keys needed, empty = placeholder on the website)
ERECHT24_API_KEY=
ERECHT24_PLUGIN_KEY=

# Seed: admin account created by `bun run db:seed`
DEFAULT_ADMIN_EMAIL=admin@soulwick.local
DEFAULT_ADMIN_PASSWORD=soulwick-admin-local

# --- Relay (apps/relay) ---

# Server: port and listen address (local port 3103 = port block 1, P-035; local "::" takes IPv6
# and IPv4, Godot tries ::1 first; the Docker image sets 8790 and 0.0.0.0)
RELAY_PORT=3103
# RELAY_HOST=

# Keys: optional other JWKS address (default <API_INTERNAL_URL>/auth/jwks) and seconds the key set
# is reused (TESTWERT; an unknown key id refetches at most every 30 s)
# JWKS_URL=
JWKS_CACHE_SECONDS=600

# Status calls: seconds an API answer is reused (TESTWERT) and timeout in ms (min. 100)
STATUS_CACHE_SECONDS=30
API_TIMEOUT_MS=2000

# Routing: whom clients may address, host_only (Godot server_relay) or any
CLIENT_ROUTING=host_only

# Limits: frame and control message size in bytes, strikes before close 4008, traffic per
# connection, connections per IP, idle and heartbeat times (TESTWERT)
MAX_FRAME_BYTES=65536
MAX_CONTROL_BYTES=4096
RATE_LIMIT_STRIKES=5
MAX_MESSAGES_PER_SECOND=1000
MAX_BYTES_PER_SECOND=1048576
MAX_CONNECTIONS_PER_IP_PER_MINUTE=30
MAX_BUFFERED_BYTES=4194304
# Seconds a receiver may stay over MAX_BUFFERED_BYTES before it is closed (4010), TESTWERT
SLOW_CONSUMER_GRACE_SECONDS=5
ROOM_IDLE_MINUTES=10
IDLE_MINUTES=10
HELLO_TIMEOUT_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_TIMEOUT_SECONDS=30

# Bad network: added latency in ms and percent of dropped unreliable packets, local tests only
# (ignored with NODE_ENV=production; also `bun run --cwd apps/relay dev --sim-latency=120 --sim-loss=5`)
RELAY_SIM_LATENCY_MS=0
RELAY_SIM_LOSS=0

# --- Website (apps/web) ---

# API: base URL of the Soulwick API, used only on the server (Dokploy: the internal address);
# the login buttons post to API_PUBLIC_URL above
API_URL=http://localhost:3102

# Visitor IP for the API's per-IP limits (src/lib/client-ip.ts). TRUST_CLOUDFLARE=true only when the
# domain runs through the Cloudflare proxy (then CF-Connecting-IP counts); TRUSTED_PROXY_HOPS =
# proxies in front of the website that append to X-Forwarded-For (Dokploy: 1 = Traefik).
TRUST_CLOUDFLARE=false
TRUSTED_PROXY_HOPS=1

# URLs: public website (canonical links, hreflang, Open Graph)
SITE_URL=http://localhost:3100

# Live features: leaderboards, guild pages and the leaderboard teaser (unset or true = on; false =
# teaser only, those pages answer 404). Read at runtime, a restart switches it.
LIVE_FEATURES=true

# --- Admin panel (apps/admin, API_URL above) ---

# Cookies: session cookie is Secure (false only for a production build over plain http)
ADMIN_COOKIE_SECURE=true
