# Shared values of one environment (all apps). Locally: copy to .env.local; api, relay and the
# Prisma CLI load it first, the app's own apps/<app>/.env.local is loaded on top and wins.
# Dokploy: .env.dev / .env.prod are the Environment Variables of the "development" /
# "production" environment; the services reference them as ${{environment.NAME}}
# (apps/<app>/.env.dev and .env.prod, infra/DOKPLOY.md §4).

# URLs: public addresses of website, admin panel, API and the browser version of the game
# (local ports: port block 1, P-035)
WEB_URL=http://localhost:3100
ADMIN_URL=http://localhost:3102
API_PUBLIC_URL=http://localhost:3101
# Browser version of the game (soulwick/deploy/web): allowed to call the API (CORS); empty = none
GAME_URL=http://localhost:3110

# Relay: public WebSocket address announced to the game
RELAY_PUBLIC_URL=ws://localhost:3103

# Internal addresses: how the services reach each other (Dokploy: the App Name of the service)
API_INTERNAL_URL=http://localhost:3101
RELAY_INTERNAL_URL=http://localhost:3103

# Database: Postgres connection (api, Prisma CLI, seeds; production: the database server)
DATABASE_URL=postgres://soulwick:soulwick-local-only@localhost:5532/soulwick

# Secrets: login secret of the API, shared key of API and relay (min. 32 characters) and the
# key of the dev login; one set per environment (openssl rand -base64 48)
BETTER_AUTH_SECRET=
RELAY_INTERNAL_KEY=
DEV_AUTH_KEY=

# Versions: network protocol (API and relay) and oldest game allowed online (empty = none)
PROTOCOL_VERSION=1
MIN_GAME_VERSION=

# Support: address shown for account deletion without the game (empty = hidden)
SUPPORT_EMAIL=hello@playsoulwick.com
